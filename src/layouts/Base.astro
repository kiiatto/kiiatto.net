---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import "@fontsource/comic-relief";
interface Props {
    title: string;
}
let { title } = Astro.props;
---

<html>
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
            data-rh="true"
        />
        <link rel="icon" type="image/xicon" href="/favicon.png" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="cat blog"
            href={new URL("rss.xml", Astro.site)}
        />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <title>{title} | kiiatto</title>
    </head>
    <body>
        <div id="sidebar-and-main">
            <Sidebar />
            <main>
                <div id="main-heading">
                    <h1>{title}</h1>
                </div>
                <div id="main-content">
                    <slot />
                </div>
            </main>
        </div>
        <Footer />
    </body>
</html>

<style>
    body {
        margin: 0 auto;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        gap: var(--gap);
        padding: var(--gap);
        max-width: 1155px;
        font-family: "Comic Relief";
    }

    #sidebar-and-main {
        display: flex;
        flex-direction: row;
        gap: var(--gap);
        max-width: 1155px;
        flex-grow: 1;
        min-height: calc(100vh - var(--gap) * 2);
    }

    main {
        max-width: 840px;
        display: flex;
        flex-grow: 1;
        flex-direction: column;
        width: 100%;
        border: var(--section-border);
        background-color: var(--background-color);
    }

    #main-heading {
        background-color: var(--background-color);
        height: 75px;
        display: flex;
        justify-content: left;
        padding: var(--gap);
        align-items: center;
        h1 {
            margin: 0;
        }
    }

    #main-content {
        display: flex;
        flex-direction: column;
        gap: var(--gap);
        padding: var(--gap);
    }
</style>
